+/* MRS: only an associated infrastructure AP can authorize this P2P context. */
+static int mrs_concurrent_go_bandwidth(struct wpa_global *global, int freq, int bandwidth) {
+	struct wpa_supplicant *station;
+	for (station = global->ifaces; station; station = station->next) {
+		const u8 *ht, *vht;
+		int center, width = 20;
+		if (station->wpa_state != WPA_COMPLETED || !station->current_ssid ||
+			station->current_ssid->mode != WPAS_MODE_INFRA ||
+			station->current_ssid->p2p_group || !station->current_bss ||
+			wpa_bss_get_vendor_ie(station->current_bss, P2P_IE_VENDOR_TYPE))
+			continue;
+		center = station->assoc_freq;
+		ht = wpa_bss_get_ie(station->current_bss, WLAN_EID_HT_OPERATION);
+		if (ht && ht[1] >= 2 && (ht[3] & 4)) {
+			if ((ht[3] & 3) == 1) { width = 40; center += 10; }
+			else if ((ht[3] & 3) == 3) { width = 40; center -= 10; }
+		}
+		vht = wpa_bss_get_ie(station->current_bss, WLAN_EID_VHT_OPERATION);
+		if (vht && vht[1] >= 5 && station->assoc_freq >= 5000 && station->assoc_freq < 5900) {
+			if (vht[2] == 1) {
+				width = 80; center = 5000 + 5 * vht[3];
+				if (vht[4]) {
+					if (abs((int)vht[4] - vht[3]) != 8) continue;
+					width = 160; center = 5000 + 5 * vht[4];
+				}
+			} else if (vht[2] == 2) { width = 160; center = 5000 + 5 * vht[3]; }
+			else if (vht[2] > 2) continue;
+		}
+		if (width >= bandwidth && freq >= center - width / 2 + 10 && freq <= center + width / 2 - 10)
+			return 1;
+	}
+	return 0;
+}
+
+int wpas_mrs_concurrent_go_channel(struct wpa_global *global, int freq) {
+	return mrs_concurrent_go_bandwidth(global, freq, 20);
+}
