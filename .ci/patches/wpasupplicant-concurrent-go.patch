+#ifdef CONFIG_P2P
+/* Only a P2P GO may use an existing infrastructure AP's occupied channels. */
+static int mrs_ap_concurrent_go_channel(void *context, int frequency) {
+	struct wpa_supplicant *group = context;
+	if (!group || !group->current_ssid || !group->current_ssid->p2p_group ||
+		(group->current_ssid->mode != WPAS_MODE_P2P_GO &&
+		 group->current_ssid->mode != WPAS_MODE_P2P_GROUP_FORMATION))
+		return 0;
+	return wpas_mrs_concurrent_go_channel(group->global, frequency);
+}
+#endif /* CONFIG_P2P */
